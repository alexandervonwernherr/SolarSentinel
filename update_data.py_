import os

import pyspedas
import pandas as pd

def main():
    print("Checking for NOAA Kp index and OMNI data files...")
    noaa_update()

def noaa_update():
    '''
    This function checks if the NOAA Kp index and OMNI data files exist.
    If they do not exist, it downloads the data using the pyspedas library and saves them as CSV files.
    '''

    kp_events = None

    kp_events = pd.read_csv("kp_events.csv", parse_dates=["date_utc"])
    kp_events['date_utc'] = pd.to_datetime(kp_events['date_utc'], errors='coerce', utc=True)
    #kp_events = kp_events[kp_events['date_utc'] >= '1970-01-02'].dropna(subset=['date_utc'])

    start = pd.Timestamp("1970-01-02", tz="UTC")
    end   = pd.Timestamp("2019-06-30", tz="UTC")
    kp_events = kp_events[kp_events["date_utc"].between(start, end)].dropna(subset=['date_utc'])
    #kp_events = kp_events[['1970-01-02'] <= kp_events['date_utc'] >= '2019-06-31'].dropna(subset=['date_utc'])

    print(kp_events.head(2))

    kp_data = []
    omni_data = []
    dscovr_data = []

    for day in kp_events["date_utc"].drop_duplicates():
        thisday = day.strftime("%Y-%m-%d")
        start_date = f'{thisday}/00:00:00'
        end_date   = f'{thisday}/23:59:59'

        print( f"Downloading NOAA Kp index data for {day}...")

        vars = pyspedas.projects.noaa.noaa_load_kp(trange=[start_date, end_date], local_kp_dir=None, datatype=[], gfz=False, prefix='', suffix='', time_clip=True, force_download=False)
        parts = {}
        for name in vars:
            d = pyspedas.get_data(name)
            parts[name] = pd.Series(d.y, index=pd.to_datetime(d.times, unit='s'))            
            data = pd.concat(parts, axis=1)  # one column per variable, aligned on time
        
        kp_data.append(data)

        print( f"Downloading OMNI data for {day}...")
        wind_data = pyspedas.projects.omni.data(trange=[start_date, end_date], datatype='1min',)
        parts = {}
        for name in wind_data:
            d = pyspedas.get_data(name)
            parts[name] = pd.Series(d.y, index=pd.to_datetime(d.times, unit='s'))
            
        try:
            df_omni = pd.concat(parts, axis=1)  # one column per variable, aligned on time
            omni_data.append(df_omni)
        except Exception as e:
            print(f"Error appending OMNI data for {day}: {e}")

        print( f"Downloading DSCOVR data for {day}...")
        dscovr_data = pyspedas.projects.dscovr.mag(
        trange=[start_date, end_date],    
        instrument=['mag', 'faraday_cup'],

        )
        print(dscovr_data)
        parts = {}

        for name in dscovr_data:
            d = pyspedas.get_data(name)

            index = pd.to_datetime(d.times, unit='s')

            if d.y.ndim == 2:
            # Create separate columns for each magnetic field component
                columns = [f'{name}_{component}' for component in ['Bx', 'By', 'Bz']]

                parts[name] = pd.DataFrame(
                d.y,
                index=index,
                columns=columns
                )
            else:
                parts[name] = pd.Series(
                d.y,
                index=index,
                name=name
        )

        try:
            df_dscovr = pd.concat(parts.values(), axis=1)        
            dscovr_data.append(df_dscovr)
        except Exception as e:
            print(f"Error appending DSCOVR data for {day}: {e}")

    # store each in a sepcerate csv file
    # convert to pd.DataFrame before saving to CSV
    
    pd.concat(kp_data).to_csv('kp_data.csv', index=True)
    pd.concat(omni_data).to_csv('omni_data.csv', index=True)
    print("DSCOVR data:" + str(dscovr_data))
    frames = [d for d in dscovr_data if isinstance(d, pd.DataFrame)]
    print(f"Found {len(frames)} DataFrame(s)")
    if frames:
        df = pd.concat(frames).resample('1min').mean().to_csv('dscovr_data.csv', index=True)
    else:
        print("No data to save")
    

if __name__ == "__main__":
    main()